# PostgreSQL connection used by the app
DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@localhost:5432/taskdb

# Separate DB for the test suite (kept isolated from dev data)
TEST_DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@localhost:5432/taskdb_test

# JWT settings
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

ENVIRONMENT=development

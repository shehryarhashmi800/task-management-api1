DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@localhost:5432/taskdb
TEST_DATABASE_URL=postgresql+psycopg2://taskuser:taskpass@localhost:5432/taskdb_test

SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ENVIRONMENT=development

LOG_LEVEL=INFO
LOG_FORMAT=text

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=30/minute

MAX_REQUEST_BODY_BYTES=1000000
ENABLE_DEBUG_ROUTES=false
